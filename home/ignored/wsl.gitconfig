[difftool]
	prompt = false

[difftool "BeyondCompare"]
	trustExitCode = true

[mergetool "BeyondCompare"]
	trustExitCode = true

[mergetool "BeyondCompare"]
	cmd='BComp.exe' "$(wslpath -aw $LOCAL)" "$(wslpath -aw $REMOTE)" "$(wslpath -aw $BASE)" "$(wslpath -aw $MERGED)"

[difftool "BeyondCompare"]
	cmd = 'BComp.exe' "$(wslpath -aw $LOCAL)" "$(wslpath -aw $REMOTE)"

# Needed to work with the some ADO repos that use git-lfs so *have* to use https instead of ssh
# Following instructions from https://github.com/git-ecosystem/git-credential-manager/blob/main/docs/wsl.md
# Git 2.56 started using the ucrt64 path; previous versions use mingw64 instead.
[credential]
	helper = /mnt/c/Program\\ Files/Git/ucrt64/bin/git-credential-manager.exe
	azreposCredentialType=oauth
	# Notes about msauthUseBroker: https://github.com/git-ecosystem/git-credential-manager/blob/main/docs/windows-broker.md
	msauthUseBroker=true
[credential "https://dev.azure.com"]
	useHttpPath = true
